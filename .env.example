# ============================================
# Payment pages configuration
# Copy this file to .env for local development.
# On Vercel, set the same variables in
# Project Settings -> Environment Variables.
# js/pay-config.js is generated from these at build time
# (see scripts/build-pay-config.js) and is never committed.
# ============================================

# Credentials for /pay-link (the payment-link generator page)
PAY_ADMIN_USER=admin
PAY_ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Key used to encrypt the payment link parameters (?d=...).
# Changing it invalidates every link already sent out.
PAY_LINK_SECRET=change-me-to-a-long-random-string

# Set to 1 to also accept readable params on /pay (?amount=...&desc=...).
# Leave at 0 so only encrypted links can prefill the page.
PAY_ALLOW_PLAIN_PARAMS=0
